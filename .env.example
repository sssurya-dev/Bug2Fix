# Bug2Fix AI — Environment Variables
# Copy this file to .env and fill in values as needed.

# IBM Bob / WatsonX integration (optional — enables live mode)
# BOB_API_KEY=
# BOB_PROJECT_ID=
# WATSONX_URL=

# Application settings
BUG2FIX_DEBUG=false
BUG2FIX_DEMO_MODE=auto   # auto|live|demo

# Baseline manual time for impact metrics (minutes)
BUG2FIX_BASELINE_MINUTES=25

# Report output directory
BUG2FIX_REPORTS_DIR=reports
